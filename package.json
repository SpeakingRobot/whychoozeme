{
  "name": "whychooseme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "windows": "npx @react-native-community/cli run-windows",
    "web": "vite --host 127.0.0.1",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "lint": "eslint App.tsx src __tests__ --quiet",
    "generate:software-catalog": "node scripts/generate-software-catalog.mjs",
    "start": "react-native start",
    "test": "jest --cacheDirectory .jest-cache",
    "test:windows": "jest --config jest.config.windows.js"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.84.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.4",
    "react-native-windows": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@rnx-kit/jest-preset": "^0.3.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "simple-icons": "16.35.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "WhyChooseMe",
      "namespace": "WhyChooseMe",
      "template": "cpp-app"
    }
  }
}
